{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Claude·Gemini·Codex 에이전트 호스트 — 공용 PC 직접 작업 + FV 대시보드 실시간 원격",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "start:direct": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "stop": "node scripts/launch.mjs --stop",
    "setup": "node scripts/setup.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-timeout=60000 \"test/**/*.test.ts\""
  },
